<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#FFFFFF"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Quay lại"
            app:tint="#333333" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:text="Thanh toán"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#333333" />
    </LinearLayout>

    <!-- Order Info Card -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="#FFFFFF">

            <TextView
                android:id="@+id/tv_order_id"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đơn hàng: #12345"
                android:textSize="16sp"
                android:textColor="#666666" />

            <TextView
                android:id="@+id/tv_order_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Thanh toán đơn hàng nội thất"
                android:textSize="14sp"
                android:textColor="#999999" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="12dp"
                android:background="#EEEEEE" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Tổng tiền:"
                    android:textSize="16sp"
                    android:textColor="#333333" />

                <TextView
                    android:id="@+id/tv_amount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1,000,000 VNĐ"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#FF5722" />
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Payment Methods -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:text="Chọn phương thức thanh toán"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#333333" />

    <LinearLayout
        android:id="@+id/ll_payment_methods"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_margin="16dp">

        <!-- COD Payment -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp">

            <Button
                android:id="@+id/btn_cod_payment"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@android:color/transparent"
                android:drawableStart="@drawable/ic_money"
                android:drawablePadding="16dp"
                android:gravity="start|center_vertical"
                android:paddingHorizontal="16dp"
                android:text="Thanh toán COD\nThanh toán khi nhận hàng"
                android:textSize="14sp"
                android:textColor="#333333"
                android:textAllCaps="false"
                android:lines="2" />
        </androidx.cardview.widget.CardView>

        <!-- VNPAY Payment -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp">

            <Button
                android:id="@+id/btn_visa_payment"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@android:color/transparent"
                android:drawableStart="@drawable/ic_credit_card"
                android:drawablePadding="16dp"
                android:gravity="start|center_vertical"
                android:paddingHorizontal="16dp"
                android:text="Thanh toán VNPAY\nThẻ ATM nội địa / Quốc tế"
                android:textSize="14sp"
                android:textColor="#333333"
                android:textAllCaps="false"
                android:lines="2" />
        </androidx.cardview.widget.CardView>

        <!-- PayPal Payment -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp">

            <Button
                android:id="@+id/btn_paypal_payment"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@android:color/transparent"
                android:drawableStart="@drawable/ic_paypal"
                android:drawablePadding="16dp"
                android:gravity="start|center_vertical"
                android:paddingHorizontal="16dp"
                android:text="Thanh toán PayPal\nVí điện tử quốc tế"
                android:textSize="14sp"
                android:textColor="#333333"
                android:textAllCaps="false"
                android:lines="2" />
        </androidx.cardview.widget.CardView>
    </LinearLayout>

</LinearLayout>
